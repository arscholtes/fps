#!/usr/bin/env bash
# fps — open the Forge / Pilot / Shepherd / Warden / Mentor sessions.
#
#   fps                  all of them, plus a plain shell, as iTerm2 tabs
#   fps forge            one role, in a new iTerm2 tab
#   fps forge --here     take over this shell instead of opening a tab
#   fps forge --repo P   bind the session to another repo
#   fps code             open a VS Code workspace with a profile per role
#   fps mine             open the project in RubyMine
#
# Tab order is forge, pilot, shepherd, warden, mentor, shell — roughly the
# direction work travels, with the watcher and the teacher at the end.

set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TAB="$SKILL_DIR/scripts/fps-tab"
VSCODE="$SKILL_DIR/scripts/fps_vscode.py"
ROLES=(forge pilot shepherd warden mentor shell)

usage() {
  cat >&2 <<'USAGE'
usage: fps [role] [--here] [--repo PATH]
       fps code [role]
       fps mine
       fps repos

  fps                 open every role plus a plain shell (iTerm2)
  fps forge           open one role in a new tab
  fps forge --here    run the role in this shell
  fps forge --repo P  bind the session to repo P instead of the current one
  fps repos           list every repo that has joined FPS
  fps code            open a VS Code workspace, one coloured profile per role
  fps mine            open the project in RubyMine

  roles: forge pilot shepherd warden mentor shell

  With no --repo, the repo is the git root of the current directory, or
  $FPS_REPO. It is fixed for the life of the session and cannot be changed
  from inside it.
USAGE
  exit 2
}

is_role() {
  for r in "${ROLES[@]}"; do [ "$1" = "$r" ] && return 0; done
  return 1
}

TARGET="iterm"
ROLE=""
HERE=0
REPO_ARG=""

while [ $# -gt 0 ]; do
  case "$1" in
    code)   TARGET="vscode" ;;
    mine)   TARGET="rubymine" ;;
    repos)  TARGET="repos" ;;
    --here) HERE=1 ;;
    --repo) shift; REPO_ARG="${1:-}"; [ -n "$REPO_ARG" ] || usage ;;
    --repo=*) REPO_ARG="${1#--repo=}" ;;
    -h|--help) usage ;;
    *) if is_role "$1"; then ROLE="$1"; else usage; fi ;;
  esac
  shift
done

# Resolved here so every downstream path agrees on one answer.
if [ -n "$REPO_ARG" ]; then
  REPO="$REPO_ARG"
elif [ -n "${FPS_REPO:-}" ]; then
  REPO="$FPS_REPO"
else
  REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo "fps: no repo to bind to — run inside a git repo, or pass --repo PATH." >&2
  exit 1
fi
REPO="$(cd "$REPO" && pwd -P)"

case "$TARGET" in
  repos)
    exec python3 "$SKILL_DIR/scripts/fps_tenant.py" list
    ;;
  vscode)
    [ -f "$VSCODE" ] || { echo "fps: missing $VSCODE" >&2; exit 1; }
    exec python3 "$VSCODE" --repo "$REPO"
    ;;
  rubymine)
    if ! command -v rubymine >/dev/null 2>&1; then
      echo "fps: the 'rubymine' launcher is not on PATH." >&2
      echo "     JetBrains Toolbox installs it under Toolbox/scripts." >&2
      exit 1
    fi
    # RubyMine's terminal cannot colour its tabs — the colours elsewhere come
    # from an iTerm escape code and a VS Code profile, neither of which it has.
    # So this opens the project and leaves the role commands ready to paste.
    rubymine "$REPO" >/dev/null 2>&1 &
    echo "opened $REPO in RubyMine."
    echo "Its terminal has no per-tab colour; start a role in any terminal tab with:"
    for r in "${ROLES[@]}"; do
      [ "$r" = "shell" ] && continue
      echo "    fps $r --here"
    done
    exit 0
    ;;
esac

if [ "$HERE" = "1" ]; then
  [ -n "$ROLE" ] || usage
  exec "$TAB" "$ROLE" "$REPO"
fi

if ! [ -d /Applications/iTerm.app ]; then
  echo "iTerm2 not found. Run a role in this shell instead:" >&2
  echo "  fps ${ROLE:-pilot} --here" >&2
  exit 1
fi

# One AppleScript call per invocation: creating tabs one-per-call races with
# iTerm's window creation and lands tabs in the wrong window.
if [ -n "$ROLE" ]; then
  osascript - "$TAB" "$ROLE" "$REPO" <<'APPLESCRIPT'
on run argv
  set tabScript to item 1 of argv
  set roleName to item 2 of argv
  set repoPath to item 3 of argv
  set cmd to quoted form of tabScript & " " & roleName & " " & quoted form of repoPath
  tell application "iTerm2"
    activate
    if (count of windows) = 0 then
      create window with default profile
      tell current session of current window to write text cmd
    else
      tell current window
        create tab with default profile
        tell current session to write text cmd
      end tell
    end if
  end tell
end run
APPLESCRIPT
  exit 0
fi

osascript - "$TAB" "$REPO" "${ROLES[@]}" <<'APPLESCRIPT'
on run argv
  set tabScript to item 1 of argv
  set repoPath to item 2 of argv
  set roleList to items 3 thru -1 of argv
  tell application "iTerm2"
    activate
    create window with default profile
    tell current window
      repeat with i from 1 to count of roleList
        set roleName to item i of roleList
        if i > 1 then create tab with default profile
        tell current session to write text (quoted form of tabScript & " " & roleName & " " & quoted form of repoPath)
      end repeat
      select first tab
    end tell
  end tell
end run
APPLESCRIPT
