#!/usr/bin/env bash
# Write each FPS charter into its Hermes profile's SOUL.md.
#
# Claude Code takes the charter as a file per launch, so it is always current.
# Hermes reads SOUL.md from the profile, so the charter has to be PUT there and
# re-put when it changes. That difference is the whole reason this script exists,
# and the reason a charter edit is not finished until this has run.
#
# Idempotent: it replaces the block it wrote rather than appending a second copy.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MARK="<!-- ===== FPS CHARTER"
ROLES=(forge pilot shepherd warden mentor)

command -v hermes >/dev/null 2>&1 || { echo "fps-hermes-sync: hermes is not on PATH." >&2; exit 1; }

for role in "${ROLES[@]}"; do
  charter="$SKILL_DIR/charters/$role.md"
  soul="$HOME/.hermes/profiles/$role/SOUL.md"
  [ -f "$charter" ] || { echo "  missing charter: $charter" >&2; exit 1; }
  if [ ! -d "$(dirname "$soul")" ]; then
    echo "  no hermes profile for $role — create it with:" >&2
    echo "    hermes profile create $role --no-alias" >&2
    exit 1
  fi

  # Everything before the marker is Hermes' own voice guidance and is left alone.
  # A charter change replaces only what this script previously wrote.
  tmp="$(mktemp)"
  awk -v mark="$MARK" 'index($0, mark) { exit } { print }' "$soul" > "$tmp"
  {
    printf '\n\n%s — synced %s ===== -->\n' "$MARK" "$(date +%F)"
    printf 'Everything below is the role charter from fps/charters/%s.md.\n' "$role"
    printf 'The guidance above is voice; this is scope. Re-run fps-hermes-sync after editing it.\n\n'
    cat "$charter"
  } >> "$tmp"
  mv "$tmp" "$soul"
  echo "  $role  <- charters/$role.md"
done
echo "synced ${#ROLES[@]} profiles. Launch one with: FPS_AGENT=hermes fps <role>"
