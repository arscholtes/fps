__pycache__/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Backup variants. An ignore rule for a file does not cover its backups, and that
# exact gap leaked twice before anything checked for it.
*.bak
*.orig
*.pre-*
*~
*.swp

# Issue tracker: contains owner email and cross-repo references.
# The issue store and its database only. NOT the whole directory: .beads/hooks
# is what wires the QA gate through core.hooksPath, and removing the directory
# left this repo pointing at a path that did not exist, with no hook running at
# all. issues.jsonl is the file that actually carries private data.
.beads/issues.jsonl
.beads/interactions.jsonl
.beads/*.db
.beads/backup/
.beads/embeddeddolt/
.beads/export-state.json
.beads/last-touched
.beads/.local_version
